{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/work-with-us",
      "destination": "/careers",
      "statusCode": 301
    },
    {
      "source": "/work-with-us.html",
      "destination": "/careers",
      "statusCode": 301
    },
    {
      "source": "/services/customer-support",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/services/customer-support.html",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/elementor-1417",
      "destination": "/blogs",
      "permanent": true
    },
    {
      "source": "/category/:path*",
      "destination": "/blogs",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/blogs",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "/blogs",
      "permanent": true
    },
    {
      "source": "/feed",
      "destination": "/blogs",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/contact",
      "permanent": true
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    }
  ],
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
